# Copy this file to `.env` and edit. It is loaded automatically by `npm start`.
# Never commit `.env` — it holds the notification topic, which acts as a password.

# Origins allowed to call the manager API, comma-separated.
# Add your machine's LAN address when testing on a phone.
ALLOWED_ORIGIN=http://localhost:5173,http://192.168.1.115:5173

# This server's address as others reach it. Used to build the link inside
# pushed reminders, so localhost is useless here once you leave this machine.
PUBLIC_URL=http://192.168.1.115:3001

# Day the owner should send the week's link. 5 = Friday, 0 = Sunday.
REMINDER_DAY=5

# Optional: where to POST the weekly reminder so it reaches a phone.
# Anyone who knows an ntfy.sh topic name can read its messages — treat it as
# a secret, and generate a new one rather than picking something memorable.
# REMINDER_WEBHOOK_URL=https://ntfy.sh/pagos-oeie8oc60cwu
